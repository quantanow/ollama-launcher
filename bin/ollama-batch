  "glm-5.1" "deepseek-v4-flash" "deepseek-v4-pro" "medgemma" "medgemma1.5"
  "laguna-xs.2" "gemma4" "qwen3.5" "lfm2" "qwen3-coder-next"
  "translategemma" "glm-4.7-flash" "lfm2.5-thinking" "ministral-3" "devstral-small-2"
  "nemotron-3-super" "glm-ocr" "qwen3-next" "nemotron-cascade-2" "rnj-1"
  "kimi-k2.5" "nemotron-3-nano" "olmo-3" "minimax-m2.7" "glm-5"
  "deepseek-ocr" "minimax-m2.5" "olmo-3.1" "devstral-2" "nomic-embed-text-v2-moe"
