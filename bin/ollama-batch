MODEL_TAGS=(
  "tools" "vision tools thinking" "vision tools thinking" "vision tools thinking audio"
  "vision tools thinking" "tools thinking" "tools thinking" "tools thinking"
  "vision" "vision" "tools thinking" "vision tools thinking audio" "vision tools thinking"
  "tools" "tools" "vision" "tools thinking" "tools" "vision tools" "vision tools"
  "tools thinking" "vision tools" "tools thinking" "tools thinking" "tools"
  "vision tools thinking" "tools thinking" "" "tools thinking" "tools thinking"
  "vision" "tools thinking" "tools" "tools" "embedding" "tools" "vision tools thinking"
  "" "tools thinking" "tools thinking" "tools" "tools thinking" "vision tools"
  "tools thinking" "vision tools thinking" "tools" "embedding" "tools" "vision tools"
  "embedding" "vision" "" "tools thinking" "tools thinking" "tools"
  "tools thinking" "tools thinking" "tools thinking" "tools" "tools thinking"
  "tools" "tools" "vision" "tools thinking" "embedding" "tools" "" ""
  "tools" "tools" "" "" "vision" "embedding" "" "" "" "vision"
  "vision" "tools" "tools" "" "" "tools" "tools" "tools"
  "embedding" "tools" "" "" "" "tools" "vision tools" "" "tools"
  "" "embedding" "" "" "tools" "tools" "tools" "embedding"
  "tools" "" "" ""
)

# ── flag parsing ──────────────────────────────────────────────────────────────
DIR=""
MODEL=""
OUT=""
PATTERN="*.txt"

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      echo "Usage: ollama-batch [--help] [--version] [--dir <path>] [--model <name>] [--out <path>] [--pattern <glob>]"
      echo
      echo "  (no args)              Interactive: pick model, pick input dir, process files"
      echo "  --dir <path>           Input directory (default: current dir)"
      echo "  --model <name>         Model name (default: interactive picker)"
      echo "  --out <path>           Output directory (default: <input_dir>_out/)"
      echo "  --pattern <glob>        File pattern (default: *.txt)"
      echo "  OLLAMA_BATCH_TEST=1   Print commands without executing"
      echo "  --version              Print version and exit"
      echo "  --help                 Show this help and exit"
      echo
      echo "Example:"
      echo "  ollama-batch --dir prompts/ --model llama3.1 --out results/"
      exit 0
      ;;
    --version|-v)
      echo "ollama-batch $VERSION"
      exit 0
      ;;
    --dir)
      DIR="$2"
      shift 2
      ;;
    --model)
      MODEL="$2"
      shift 2
      ;;
    --out)
      OUT="$2"
      shift 2
      ;;
    --pattern)
      PATTERN="$2"
      shift 2
      ;;
    *)
      echo -e "${BOLD_RED}Error:${RESET} Unknown option: ${1}"
      echo "Run 'ollama-batch --help' for usage."
      exit 1
      ;;
  esac
done

# ── main ──────────────────────────────────────────────────────────────────────
if [ -z "${OLLAMA_BATCH_TEST:-}" ]; then
  check_ollama
fi

# Resolve input directory
if [ -z "$DIR" ]; then
  if [ -t 0 ]; then
    printf "${BOLD}Input directory:${RESET} "
    read -r DIR 2>/dev/null || { echo; exit 0; }
    [ -z "$DIR" ] && DIR="."
  else
    DIR="."
  fi
fi

if [ ! -d "$DIR" ]; then
  echo -e "${BOLD_RED}Error:${RESET} Directory not found: $DIR"
  exit 1
fi

DIR="$(cd "$DIR" && pwd)"

# Resolve model
if [ -z "$MODEL" ]; then
  PICK_RESULT=""
  pick_model
  MODEL="$PICK_RESULT"
fi

if [ -z "$MODEL" ]; then
  echo -e "${BOLD}Cancelled.${RESET}"
  exit 0
fi

# Resolve output directory
if [ -z "$OUT" ]; then
  OUT="${DIR}_out"
fi

mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"

# Count files
total_raw=$(count_files "$DIR" "$PATTERN")
if [ "$total_raw" -eq 0 ]; then
  echo -e "${BOLD_RED}Error:${RESET} No files matching '$PATTERN' in $DIR"
  exit 1
fi

echo
echo -e "${BOLD_CYAN}Batch processing:${RESET}"
echo -e "  ${FZF_META}Model:${RESET}   ${WHITE}$MODEL${RESET}"
echo -e "  ${FZF_META}Input:${RESET}   ${WHITE}$DIR${RESET}"
echo -e "  ${FZF_META}Output:${RESET}  ${WHITE}$OUT${RESET}"
echo -e "  ${FZF_META}Pattern:${RESET} ${WHITE}$PATTERN${RESET}"
echo -e "  ${FZF_META}Files:${RESET}   ${WHITE}$total_raw${RESET}"
echo

# Process files
processed=0
skipped=0

while IFS= read -r filepath; do
  [ -n "$filepath" ] || continue
  filename=$(basename "$filepath")
  outpath="${OUT}/${filename}"

  if [ -s "$outpath" ]; then
    echo -e "  ${FZF_META}Skip:${RESET} $filename ${FZF_META}(already exists)${RESET}"
    skipped=$((skipped + 1))
    continue
  fi

  processed=$((processed + 1))

  if [ -n "${OLLAMA_BATCH_TEST:-}" ]; then
    echo -e "  ${BOLD_AMBER}Would run:${RESET} ollama run $MODEL \"<contents of $filename>\" > $outpath"
    printf '%s\n' "TEST OUTPUT for $filename" > "$outpath"
  else
    echo -e "  ${BOLD_AMBER}Running:${RESET} $filename ..."
    # Read file contents and pass to ollama run
    contents=$(cat "$filepath")
    ollama run "$MODEL" "$contents" > "$outpath" 2>&1 || true
    echo -e "  ${BOLD_GREEN}Done:${RESET}   $filename"
  fi
done <<< "$(list_files "$DIR" "$PATTERN")"

echo
echo -e "${BOLD_GREEN}Finished:${RESET} $processed processed, $skipped skipped"
echo -e "${FZF_META}Output directory:${RESET} $OUT"
