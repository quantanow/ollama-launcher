#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
[ -L "$SCRIPT_SOURCE" ] && SCRIPT_SOURCE=$(readlink -f "$SCRIPT_SOURCE" 2>/dev/null || readlink "$SCRIPT_SOURCE")
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

pkg_ver=""
for dir in "$SCRIPT_DIR" "$SCRIPT_DIR/.."; do
  if [ -f "$dir/package.json" ]; then
    ver=$(grep '"version"' "$dir/package.json" | sed 's/.*"version": "\([^"]*\)".*/\1/')
    if [ -n "$ver" ]; then
      pkg_ver="$ver"
      break
    fi
  fi
done
VERSION="${pkg_ver:-1.1.13}"

if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[36m'
  WHITE='\033[37m'
  GREEN='\033[32m'
  RED='\033[31m'
  AMBER='\033[38;5;214m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' WHITE='' GREEN='' RED='' AMBER='' RESET=''
fi

BOLD_CYAN="${BOLD}${CYAN}"
BOLD_GREEN="${BOLD}${GREEN}"
BOLD_RED="${BOLD}${RED}"
BOLD_AMBER="${BOLD}${AMBER}"
BOLD_WHITE="${BOLD}${WHITE}"

FZF_NAME=$'\033[1;96m'
FZF_META=$'\033[2m'
FZF_RST=$'\033[0m'

# ── helpers ───────────────────────────────────────────────────────────────────
check_ollama() {
  if ! command -v ollama &>/dev/null; then
    echo -e "${BOLD_RED}Error:${RESET} ollama is not installed or not in PATH."
    exit 1
  fi
}

count_files() {
  local dir="$1" pattern="$2"
  find "$dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | wc -l | tr -d '[:space:]'
}

list_files() {
  local dir="$1" pattern="$2"
  find "$dir" -maxdepth 1 -type f -name "$pattern" | sort
}

pick_fzf() {
  local header="$1"
  shift
  fzf \
    --ansi \
    --height=50% \
    --layout=reverse \
    --border \
    --prompt="  Select: " \
    --header="  ${header}" \
    --color="header:italic,border:cyan" \
    "$@" \
    2>/dev/null || true
}

# pick_model from ollama-launch (simplified inline)
pick_model() {
  local total=${#MODEL_NAMES[@]}
  local lines=()
  local i
  for ((i=0; i<total; i++)); do
    local tags=""
    if [ "${MODEL_TAGS[$i]}" != "" ]; then
      tags=" | ${MODEL_TAGS[$i]}"
    fi
    lines+=("${FZF_NAME}${MODEL_NAMES[$i]}${FZF_RST} | ${FZF_META}${MODEL_PULLS[$i]} pulls${tags}${FZF_RST}")
  done

  local selected
  if command -v fzf &>/dev/null; then
    selected=$(printf '%s\n' "${lines[@]}" | pick_fzf "Pick a model")
  else
    local menu_file
    menu_file="/tmp/ollama-batch-menu-$$"
    printf '%s\n' "${lines[@]}" > "$menu_file"

    # Inline menu picker
    local total_lines i2
    total_lines=$(wc -l < "$menu_file" | tr -d '[:space:]')
    echo -e "${BOLD_WHITE}Available models:${RESET}" &&2
    echo &&2
    i2=0
    while IFS= read -r line; do
      printf "  ${BOLD_GREEN}%2d${RESET}  %s\n" "$((i2 + 1))" "$line" &&2
      i2=$((i2 + 1))
    done < "$menu_file"
    echo &&2

    while true; do
      printf "${BOLD_GREEN}Enter number [1-%s]:${RESET} " "$total_lines" &&2
      read -r choice </dev/tty 2>/dev/null || read -r choice 2>/dev/null || { echo &&2; rm -f "$menu_file"; exit 0; }
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total_lines" ]; then
        selected=$(sed -n "${choice}p" "$menu_file")
        break
      fi
      echo -e "${BOLD_RED}Invalid choice.${RESET}" &&2
    done
    rm -f "$menu_file"
  fi

  if [ -z "$selected" ]; then exit 0; fi
  local model_name="${selected%% | *}"
  local _esc; _esc=$(printf '\033')
  model_name=$(printf '%s' "$model_name" | sed "s/${_esc}\[[0-9;]*m//g")
  PICK_RESULT="$model_name"
}

# Source model arrays inline (same as ollama-launch)
MODEL_NAMES=(
