# ── helpers ───────────────────────────────────────────────────────────────────
print_header() {
  echo -e "${BOLD_CYAN}┌─────────────────────────────┐${RESET}"
  echo -e "${BOLD_CYAN}│${RESET}  ${BOLD_WHITE}ollama-launch  🦙${RESET}           ${BOLD_CYAN}│${RESET}"
  echo -e "${BOLD_CYAN}│${RESET}  ${WHITE}Pick an agent and model${RESET}     ${BOLD_CYAN}│${RESET}"
  echo -e "${BOLD_CYAN}└─────────────────────────────┘${RESET}"
  echo
}

print_agents() {
  for agent in "${AGENTS[@]}"; do
    echo "$agent"
  done
}

print_models() {
  local i
  for ((i=0; i<${#MODEL_NAMES[@]}; i++)); do
    echo "${MODEL_NAMES[$i]}"
  done
}

print_models_cloud() {
  local i _vref v
  for ((i=0; i<${#MODEL_NAMES[@]}; i++)); do
    if [ "${MODEL_HAS_VARIANTS[$i]}" -eq 1 ]; then
      _vref="MODEL_VARIANTS_${i}[@]"
      for v in "${!_vref}"; do
        if [[ "$v" == *:cloud ]]; then
          echo "$v"
          break
        fi
      done
    fi
  done
}

check_ollama() {
  if ! command -v ollama &>/dev/null; then
    echo -e "${BOLD_RED}Error:${RESET} ollama is not installed or not in PATH."
    echo "  Install it at: https://ollama.com/download"
    exit 1
  fi
}

install_fzf() {
  echo -e "${BOLD_CYAN}Installing fzf for better selection...${RESET}"
  if command -v brew &>/dev/null; then
    brew install fzf
  elif command -v apt-get &>/dev/null; then
    sudo apt-get install -y fzf
  elif command -v yum &>/dev/null; then
    sudo yum install -y fzf
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y fzf
  else
    echo -e "${BOLD_RED}Error:${RESET} Could not find a package manager to install fzf."
    echo "  Please install fzf manually: https://github.com/junegunn/fzf#installation"
    exit 1
  fi
}

# pick_fzf <prompt_label> <header_text> <items_fn>
# Prints the selected item, or exits 0 if cancelled.
pick_fzf() {
  local label="$1" header="$2" items_fn="$3"
  local result
  result=$("$items_fn" | fzf \
    --height=40% \
    --layout=reverse \
    --border \
    --prompt="  ${label}: " \
    --header="  ${header}" \
    --color="header:italic,border:cyan" \
    2>/dev/null || true)
  echo "$result"
}

# pick_menu <label> <array_name>
# Sets PICK_RESULT to the chosen item, or exits 0 if cancelled.
pick_menu() {
  local label="$1"
  local array_name="$2"
  local total i

  # Get array length using eval (bash 3.2 compatible)
  eval "total=\${#${array_name}[@]}"

  echo -e "${BOLD_WHITE}Available ${label}s:${RESET}"
  echo
  for ((i=0; i<total; i++)); do
    eval "printf \"  ${BOLD_GREEN}%2d\${RESET}  ${WHITE}%s\${RESET}\\n\" \"\$((i + 1))\" \"\${${array_name}[\$i]}\""
  done
  echo

  PICK_RESULT=""
  while true; do
    printf "${BOLD_GREEN}Enter number [1-%d]:${RESET} " "$total"
    read -r choice 2>/dev/null || { echo; exit 0; }

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
      eval "PICK_RESULT=\${${array_name}[\$((choice - 1))]}"
      break
    fi

    echo -e "${BOLD_RED}Invalid choice.${RESET} Enter a number between 1 and ${total}."
  done
}

# pick_fzf_raw <label> <header>
# Reads items from stdin. Prints selected line, or empty string if cancelled.
pick_fzf_raw() {
  local label="$1" header="$2"
  shift 2
  fzf \
    --ansi \
    --height=40% \
    --layout=reverse \
    --border \
    --prompt="  ${label}: " \
    --header="  ${header}" \
    --color="header:italic,border:cyan" \
    "$@" \
    2>/dev/null || true
}

# pick_menu_raw <label> <file>
# Reads items from file into numbered menu. Prints the selected line to stdout.
# UI output goes to stderr so callers can capture only the selection.
pick_menu_raw() {
  local label="$1"
  local file="$2"
  local lines
  lines=()
  while IFS= read -r line; do
    lines+=("$line")
  done < "$file"
  local total=${#lines[@]}

  if [ "$total" -eq 0 ]; then
    echo "No ${label}s available." >&2
    exit 0
  fi

  echo -e "${BOLD_WHITE}Available ${label}s:${RESET}" >&2
  echo >&2
  for ((i=0; i<total; i++)); do
    printf "  ${BOLD_GREEN}%2d${RESET}  ${WHITE}%s${RESET}\n" "$((i + 1))" "${lines[$i]}" >&2
  done
  echo >&2

  while true; do
    printf "${BOLD_GREEN}Enter number [1-%d]:${RESET} " "$total" >&2
    read -r choice </dev/tty 2>/dev/null || read -r choice 2>/dev/null || { echo >&2; exit 0; }

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
      echo "${lines[$((choice - 1))]}"
      break
    fi

    echo -e "${BOLD_RED}Invalid choice.${RESET} Enter a number between 1 and ${total}." >&2
  done
}

# pick_model
# Presents metadata-rich list of all models. Sets PICK_MODEL_INDEX to selected index.
# Prints selected model name (base name, not variant).
pick_model() {
  local total=${#MODEL_NAMES[@]}
  local lines
  lines=()
  local i

  for ((i=0; i<total; i++)); do
    local input_type variant_search _vref
    if [ "${MODEL_HAS_VARIANTS[$i]}" -eq 1 ]; then
      eval "input_type=\${MODEL_INPUTS_${i}[0]}"
      _vref="MODEL_VARIANTS_${i}[@]"
      variant_search="${!_vref}"
    else
      input_type="N/A"
      variant_search=""
    fi
    lines+=("${FZF_NAME}${MODEL_NAMES[$i]}${FZF_RST} | ${FZF_META}${MODEL_PULLS[$i]} pulls | ${MODEL_TAGS[$i]} | $input_type${FZF_RST}"$'\t'"$variant_search")
  done

  local selected
  if command -v fzf &>/dev/null; then
    selected=$(printf '%s\n' "${lines[@]}" | pick_fzf_raw "Model" "↑↓ navigate  /  type to filter  /  Enter to run  /  Esc to quit" --delimiter=$'\t' --with-nth=1)
  else
    local menu_file
    menu_file="/tmp/ollama-launch-menu-$$"
    printf '%s\n' "${lines[@]}" > "$menu_file"
    selected=$(pick_menu_raw "model" "$menu_file")
    rm -f "$menu_file"
  fi

  if [ -z "$selected" ]; then exit 0; fi

  local model_name="${selected%% | *}"
  local _esc; _esc=$(printf '\033')
  model_name=$(printf '%s' "$model_name" | sed "s/${_esc}\[[0-9;]*m//g")

  PICK_MODEL_INDEX=-1
  for ((i=0; i<total; i++)); do
    if [ "${MODEL_NAMES[$i]}" = "$model_name" ]; then
      PICK_MODEL_INDEX=$i
      break
    fi
  done

  if [ "$PICK_MODEL_INDEX" -eq -1 ]; then
    echo "Error: could not resolve model index for '$model_name'" >&2
    exit 1
  fi

  PICK_RESULT="$model_name"
}

# pick_variant <model_index>
# If model has 0 variants, returns empty string.
# If model has 1 variant, returns it directly.
# If model has 2+ variants, presents a sub-picker and returns selected variant name.
pick_variant() {
  local idx="$1"
  local variants_name="MODEL_VARIANTS_${idx}[@]"

  local variants
  variants=()
  eval "variants=(\"\${${variants_name}:-}\")" 2>/dev/null || true

  local count=${#variants[@]}
  if [ "$count" -eq 0 ]; then
    echo ""
    return
  fi
  if [ "$count" -eq 1 ]; then
    echo "${variants[0]}"
    return
  fi

  local lines
  lines=()
  local i
  for ((i=0; i<count; i++)); do
    local size context input_type
    eval "size=\${MODEL_SIZES_${idx}[\$i]}"
    eval "context=\${MODEL_CONTEXTS_${idx}[\$i]}"
    eval "input_type=\${MODEL_INPUTS_${idx}[\$i]}"
    lines+=("${FZF_NAME}${variants[$i]}${FZF_RST} | ${FZF_META}$size | $context context | $input_type${FZF_RST}")
  done

  local selected
  if command -v fzf &>/dev/null; then
    selected=$(printf '%s\n' "${lines[@]}" | pick_fzf_raw "Variant" "↑↓ navigate  /  type to filter  /  Enter to select  /  Esc to quit")
  else
    local menu_file
    menu_file="/tmp/ollama-launch-variant-$$"
    printf '%s\n' "${lines[@]}" > "$menu_file"
    selected=$(pick_menu_raw "variant" "$menu_file")
    rm -f "$menu_file"
  fi

  if [ -z "$selected" ]; then exit 0; fi
  local raw_variant="${selected%% | *}"
  local _esc; _esc=$(printf '\033')
  raw_variant=$(printf '%s' "$raw_variant" | sed "s/${_esc}\[[0-9;]*m//g")
  echo "$raw_variant"
}

# ── flag parsing ──────────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h)
    echo "Usage: ollama-launch [--help] [--version] [--list-agents] [--list-models [--cloud]]"
    echo
    echo "  (no args)              Pick an agent and model interactively, then launch"
    echo "  --list-agents          Print all available agents and exit"
    echo "  --list-models          Print all available models and exit"
    echo "  --list-models --cloud  Print only models that have a :cloud variant and exit"
    echo "  --version              Print version and exit"
    echo "  --help                 Show this help and exit"
    echo
    echo "Example command run: ollama launch claude --model granite4.1:8b"
    exit 0
    ;;
  --version|-v)
    echo "ollama-launch $VERSION"
    exit 0
    ;;
  --list-agents)
    print_agents
    exit 0
    ;;
  --list-models)
    if [ "${2:-}" = "--cloud" ]; then
      print_models_cloud
    else
      print_models
    fi
    exit 0
    ;;
  "")
    ;;
  *)
    echo -e "${BOLD_RED}Error:${RESET} Unknown option: ${1}"
    echo "Run 'ollama-launch --help' for usage."
    exit 1
    ;;
esac

# ── main ──────────────────────────────────────────────────────────────────────
if [ -n "${OLLAMA_LAUNCH_SKIP_MAIN:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

check_ollama
print_header

# ── fzf check ─────────────────────────────────────────────────────────────────
if ! command -v fzf &>/dev/null; then
  if [ -z "${OLLAMA_LAUNCH_TEST:-}" ]; then
    echo -e "${BOLD_RED}fzf is not installed.${RESET}"
    echo "  fzf provides a better selection experience with search/filter."
    echo
    printf "  Install fzf now? [y/N] "
    read -r install_fzf_choice 2>/dev/null || { echo; exit 0; }
    if [[ "$install_fzf_choice" =~ ^[Yy]$ ]]; then
      install_fzf
    else
      echo -e "  ${WHITE}Continuing with menu-based selection...${RESET}"
      echo
    fi
  fi
fi

# ── step 1: pick agent ────────────────────────────────────────────────────────
if command -v fzf &>/dev/null; then
  agent=$(pick_fzf "Agent" "↑↓ navigate  /  type to filter  /  Enter to select  /  Esc to quit" print_agents)
  if [ -z "$agent" ]; then exit 0; fi
else
  pick_menu "agent" AGENTS
  agent="$PICK_RESULT"
  if [ -z "$agent" ]; then exit 0; fi
fi

echo -e "  Agent:  ${BOLD_GREEN}${agent}${RESET}"
echo

# ── step 2: pick model ────────────────────────────────────────────────────────
pick_model
model_name="$PICK_RESULT"
if [ -z "$model_name" ]; then exit 0; fi

echo -e "  Model:  ${BOLD_GREEN}${model_name}${RESET}"
echo

# ── step 2b: pick variant (if applicable) ───────────────────────────────────
final_model="$model_name"
if [ "$PICK_MODEL_INDEX" -ge 0 ] && [ "${MODEL_HAS_VARIANTS[$PICK_MODEL_INDEX]}" -eq 1 ]; then
  variant=$(pick_variant "$PICK_MODEL_INDEX")
  if [ -n "$variant" ]; then
    final_model="$variant"
  fi
fi

if [ "$final_model" != "$model_name" ]; then
  echo -e "  Variant: ${BOLD_GREEN}${final_model}${RESET}"
  echo
fi

# ── launch ────────────────────────────────────────────────────────────────────
if [ -n "${OLLAMA_LAUNCH_TEST:-}" ]; then
  echo "ollama launch ${agent} --model ${final_model}"
  exit 0
fi

echo -e "${BOLD_CYAN}Running:${RESET} ollama launch ${agent} --model ${final_model}"
echo
exec ollama launch "$agent" --model "$final_model"
