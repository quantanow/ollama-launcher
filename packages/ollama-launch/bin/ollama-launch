#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
[ -L "$SCRIPT_SOURCE" ] && SCRIPT_SOURCE=$(readlink -f "$SCRIPT_SOURCE" 2>/dev/null || readlink "$SCRIPT_SOURCE")
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# package.json may be in SCRIPT_DIR (dev) or parent (installed via npm)
pkg_ver=""
for dir in "$SCRIPT_DIR" "$SCRIPT_DIR/.."; do
  if [ -f "$dir/package.json" ]; then
    ver=$(grep '"version"' "$dir/package.json" | sed 's/.*"version": "\([^"]*\)".*/\1/')
    if [ -n "$ver" ]; then
      pkg_ver="$ver"
      break
    fi
  fi
done
VERSION="${pkg_ver:-1.1.13}"

# ── colors (disabled when stdout is not a TTY) ────────────────────────────────
if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[36m'
  WHITE='\033[37m'
  GREEN='\033[32m'
  RED='\033[31m'
  AMBER='\033[38;5;214m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' WHITE='' GREEN='' RED='' AMBER='' RESET=''
fi

BOLD_CYAN="${BOLD}${CYAN}"
BOLD_WHITE="${BOLD}${WHITE}"
BOLD_GREEN="${BOLD}${GREEN}"
BOLD_AMBER="${BOLD}${AMBER}"

# fzf display colors — always defined (not TTY-gated) because fzf reads from a pipe
FZF_NAME=$'\033[1;96m'  # bold bright cyan — model/variant name
FZF_META=$'\033[2m'     # dim — pulls, tags, size details
FZF_RST=$'\033[0m'      # reset
BOLD_RED="${BOLD}${RED}"

# ── agent list ────────────────────────────────────────────────────────────────
AGENTS=(
  "claude"
  "codex"
  "hermes"
  "openclaw"
  "opencode"
)

# ── model list ────────────────────────────────────────────────────────────────
# MODEL DATA BEGIN — generated by scripts/generate-model-data.js
MODEL_NAMES=(
)

MODEL_PULLS=(
)

MODEL_TAGS=(
)

MODEL_HAS_VARIANTS=(
)

# MODEL DATA END























# ── helpers ───────────────────────────────────────────────────────────────────
print_header() {
  echo -e "${BOLD_CYAN}┌─────────────────────────────┐${RESET}"
  echo -e "${BOLD_CYAN}│${RESET}  ${BOLD_WHITE}ollama-launch  🦙${RESET}           ${BOLD_CYAN}│${RESET}"
  echo -e "${BOLD_CYAN}│${RESET}  ${WHITE}Pick an agent and model${RESET}     ${BOLD_CYAN}│${RESET}"
  echo -e "${BOLD_CYAN}└─────────────────────────────┘${RESET}"
  echo
}

print_agents() {
  for agent in "${AGENTS[@]}"; do
    echo "$agent"
  done
}

print_models() {
  local i
  for ((i=0; i<${#MODEL_NAMES[@]}; i++)); do
    echo "${MODEL_NAMES[$i]}"
  done
}

print_models_cloud() {
  local i _vref v
  for ((i=0; i<${#MODEL_NAMES[@]}; i++)); do
    if [ "${MODEL_HAS_VARIANTS[$i]}" -eq 1 ]; then
      _vref="MODEL_VARIANTS_${i}[@]"
      for v in "${!_vref}"; do
        if [[ "$v" == *:cloud ]]; then
          echo "$v"
          break
        fi
      done
    fi
  done
}

check_ollama() {
  if ! command -v ollama &>/dev/null; then
    echo -e "${BOLD_RED}Error:${RESET} ollama is not installed or not in PATH."
    echo "  Install it at: https://ollama.com/download"
    exit 1
  fi
}

install_fzf() {
  echo -e "${BOLD_CYAN}Installing fzf for better selection...${RESET}"
  if command -v brew &>/dev/null; then
    brew install fzf
  elif command -v apt-get &>/dev/null; then
    sudo apt-get install -y fzf
  elif command -v yum &>/dev/null; then
    sudo yum install -y fzf
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y fzf
  else
    echo -e "${BOLD_RED}Error:${RESET} Could not find a package manager to install fzf."
    echo "  Please install fzf manually: https://github.com/junegunn/fzf#installation"
    exit 1
  fi
}

# pick_fzf <prompt_label> <header_text> <items_fn>
# Prints the selected item, or exits 0 if cancelled.
pick_fzf() {
  local label="$1" header="$2" items_fn="$3"
  local result
  result=$("$items_fn" | fzf \
    --height=40% \
    --layout=reverse \
    --border \
    --prompt="  ${label}: " \
    --header="  ${header}" \
    --color="header:italic,border:cyan" \
    2>/dev/null || true)
  echo "$result"
}

# pick_menu <label> <array_name>
# Sets PICK_RESULT to the chosen item, or exits 0 if cancelled.
pick_menu() {
  local label="$1"
  local array_name="$2"
  local total i

  # Get array length using eval (bash 3.2 compatible)
  eval "total=\${#${array_name}[@]}"

  echo -e "${BOLD_WHITE}Available ${label}s:${RESET}"
  echo
  for ((i=0; i<total; i++)); do
    eval "printf \"  ${BOLD_GREEN}%2d\${RESET}  ${WHITE}%s\${RESET}\\n\" \"\$((i + 1))\" \"\${${array_name}[\$i]}\""
  done
  echo

  PICK_RESULT=""
  while true; do
    printf "${BOLD_GREEN}Enter number [1-%d]:${RESET} " "$total"
    read -r choice 2>/dev/null || { echo; exit 0; }

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
      eval "PICK_RESULT=\${${array_name}[\$((choice - 1))]}"
      break
    fi

    echo -e "${BOLD_RED}Invalid choice.${RESET} Enter a number between 1 and ${total}."
  done
}

# pick_fzf_raw <label> <header>
# Reads items from stdin. Prints selected line, or empty string if cancelled.
pick_fzf_raw() {
  local label="$1" header="$2"
  shift 2
  fzf \
    --ansi \
    --height=40% \
    --layout=reverse \
    --border \
    --prompt="  ${label}: " \
    --header="  ${header}" \
    --color="header:italic,border:cyan" \
    "$@" \
    2>/dev/null || true
}

# pick_menu_raw <label> <file>
# Reads items from file into numbered menu. Prints the selected line to stdout.
# UI output goes to stderr so callers can capture only the selection.
pick_menu_raw() {
  local label="$1"
  local file="$2"
  local lines
  lines=()
  while IFS= read -r line; do
    lines+=("$line")
  done < "$file"
  local total=${#lines[@]}

  if [ "$total" -eq 0 ]; then
    echo "No ${label}s available." >&2
    exit 0
  fi

  echo -e "${BOLD_WHITE}Available ${label}s:${RESET}" >&2
  echo >&2
  for ((i=0; i<total; i++)); do
    printf "  ${BOLD_GREEN}%2d${RESET}  ${WHITE}%s${RESET}\n" "$((i + 1))" "${lines[$i]}" >&2
  done
  echo >&2

  while true; do
    printf "${BOLD_GREEN}Enter number [1-%d]:${RESET} " "$total" >&2
    read -r choice </dev/tty 2>/dev/null || read -r choice 2>/dev/null || { echo >&2; exit 0; }

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
      echo "${lines[$((choice - 1))]}"
      break
    fi

    echo -e "${BOLD_RED}Invalid choice.${RESET} Enter a number between 1 and ${total}." >&2
  done
}

# ── recent history ─────────────────────────────────────────────────────────────
HISTORY_ENTRIES=()

history_file() { printf '%s/.ollama-launch-history' "$HOME"; }

load_history() {
  HISTORY_ENTRIES=()
  local f; f=$(history_file)
  [ -f "$f" ] || return 0
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && HISTORY_ENTRIES+=("$line")
  done < "$f"
}

save_history() {
  local agent="$1" model="$2"
  local new_entry="${agent}|${model}"
  local f; f=$(history_file)
  load_history
  local updated=("$new_entry")
  local entry
  if [ "${#HISTORY_ENTRIES[@]}" -gt 0 ]; then
    for entry in "${HISTORY_ENTRIES[@]}"; do
      [ "$entry" = "$new_entry" ] && continue
      [ "${#updated[@]}" -ge 5 ] && break
      updated+=("$entry")
    done
  fi
  printf '%s\n' "${updated[@]}" > "$f"
}

# pick_recent
# Shows recent agent+model combos followed by the agent list in one fzf popup.
# - Selecting a recent entry sets both RECENT_AGENT and RECENT_MODEL (skips all pickers).
# - Selecting an agent sets only RECENT_AGENT (proceeds to model+variant pickers).
# - Selecting a separator or cancelling leaves both empty (full 3-step flow).
pick_recent() {
  local total=${#HISTORY_ENTRIES[@]}
  [ "$total" -eq 0 ] && return 0

  RECENT_AGENT=""
  RECENT_MODEL=""

  local lines=()
  local entry agent_part model_part
  if [ "${#HISTORY_ENTRIES[@]}" -gt 0 ]; then
    for entry in "${HISTORY_ENTRIES[@]}"; do
      agent_part="${entry%%|*}"
      model_part="${entry##*|}"
      lines+=("${FZF_NAME}${agent_part}${FZF_RST}  ${FZF_META}│  ${model_part}${FZF_RST}")
    done
  fi

  local selected
  if command -v fzf &>/dev/null; then
    local separator="${FZF_META}  ──────────────────────────────────────${FZF_RST}"
    local a
    selected=$(
      {
        printf '%s\n' "$separator"
        printf '%s\n' "${lines[@]}"
        printf '%s\n' "$separator"
        for a in "${AGENTS[@]}"; do printf '%s\n' "${FZF_NAME}${a}${FZF_RST}"; done
      } | pick_fzf_raw "Recent" "↑↓ navigate  /  Enter to select  /  Esc to quit"
    )
  else
    local tmpfile; tmpfile=$(mktemp)
    local e
    for e in "${HISTORY_ENTRIES[@]}"; do
      printf '%s  │  %s\n' "${e%%|*}" "${e##*|}" >> "$tmpfile"
    done
    printf '%s\n' "──────────────────────────────────────" >> "$tmpfile"
    local a
    for a in "${AGENTS[@]}"; do printf '%s\n' "$a" >> "$tmpfile"; done
    selected=$(pick_menu_raw "recent launch" "$tmpfile")
    rm -f "$tmpfile"
  fi

  local esc=$'\033'
  local clean; clean=$(printf '%s' "$selected" | sed "s/${esc}\[[0-9;]*m//g")

  # Empty or separator line → cancel (full 3-step flow)
  if [ -z "$clean" ] || [[ "$clean" == *"──"* ]]; then
    return 0
  fi

  # Recent entry: contains │
  if [[ "$clean" == *"│"* ]]; then
    local raw_agent raw_model
    raw_agent=$(printf '%s' "$clean" | sed 's/[[:space:]]*│.*//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
    raw_model=$(printf '%s' "$clean" | sed 's/.*│[[:space:]]*//')
    if [ -n "$raw_agent" ] && [ -n "$raw_model" ]; then
      RECENT_AGENT="$raw_agent"
      RECENT_MODEL="$raw_model"
    fi
    return 0
  fi

  # Agent name selected → set agent only, model picker follows
  local agent_name; agent_name=$(printf '%s' "$clean" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
  local a
  for a in "${AGENTS[@]}"; do
    if [ "$agent_name" = "$a" ]; then
      RECENT_AGENT="$agent_name"
      return 0
    fi
  done
}

# pick_model
# Presents metadata-rich list of all models. Sets PICK_MODEL_INDEX to selected index.
# Prints selected model name (base name, not variant).
pick_model() {
  local total=${#MODEL_NAMES[@]}
  local lines
  lines=()
  local i

  for ((i=0; i<total; i++)); do
    local input_type tags _vref variant_search cloud_tag
    if [ "${MODEL_HAS_VARIANTS[$i]}" -eq 1 ]; then
      eval "input_type=\${MODEL_INPUTS_${i}[0]}"
      _vref="MODEL_VARIANTS_${i}[@]"
      variant_search="${!_vref}"
      if [[ "$variant_search" == *:cloud* ]]; then
        cloud_tag=" cloud"
      else
        cloud_tag=""
      fi
    else
      input_type="N/A"
      cloud_tag=""
    fi
    tags="${MODEL_TAGS[$i]}${cloud_tag}"
    lines+=("${FZF_NAME}${MODEL_NAMES[$i]}${FZF_RST} | ${FZF_META}${MODEL_PULLS[$i]} pulls | $tags | $input_type${FZF_RST}")
  done

  local selected
  if command -v fzf &>/dev/null; then
    selected=$(printf '%s\n' "${lines[@]}" | pick_fzf_raw "Model" "↑↓ navigate  /  type to filter  /  Enter to run  /  Esc to quit")
  else
    local menu_file
    menu_file="/tmp/ollama-launch-menu-$$"
    printf '%s\n' "${lines[@]}" > "$menu_file"
    selected=$(pick_menu_raw "model" "$menu_file")
    rm -f "$menu_file"
  fi

  if [ -z "$selected" ]; then exit 0; fi

  local model_name="${selected%% | *}"
  local _esc; _esc=$(printf '\033')
  model_name=$(printf '%s' "$model_name" | sed "s/${_esc}\[[0-9;]*m//g")

  PICK_MODEL_INDEX=-1
  for ((i=0; i<total; i++)); do
    if [ "${MODEL_NAMES[$i]}" = "$model_name" ]; then
      PICK_MODEL_INDEX=$i
      break
    fi
  done

  if [ "$PICK_MODEL_INDEX" -eq -1 ]; then
    echo "Error: could not resolve model index for '$model_name'" >&2
    exit 1
  fi

  PICK_RESULT="$model_name"
}

# pick_variant <model_index>
# If model has 0 variants, returns empty string.
# If model has 1 variant, returns it directly.
# If model has 2+ variants, presents a sub-picker and returns selected variant name.
pick_variant() {
  local idx="$1"
  local variants_name="MODEL_VARIANTS_${idx}[@]"

  local variants
  variants=()
  eval "variants=(\"\${${variants_name}:-}\")" 2>/dev/null || true

  local count=${#variants[@]}
  if [ "$count" -eq 0 ]; then
    echo ""
    return
  fi
  if [ "$count" -eq 1 ]; then
    echo "${variants[0]}"
    return
  fi

  local lines
  lines=()
  local i
  for ((i=0; i<count; i++)); do
    local size context input_type
    eval "size=\${MODEL_SIZES_${idx}[\$i]}"
    eval "context=\${MODEL_CONTEXTS_${idx}[\$i]}"
    eval "input_type=\${MODEL_INPUTS_${idx}[\$i]}"
    lines+=("${FZF_NAME}${variants[$i]}${FZF_RST} | ${FZF_META}$size | $context context | $input_type${FZF_RST}")
  done

  local selected
  if command -v fzf &>/dev/null; then
    selected=$(printf '%s\n' "${lines[@]}" | pick_fzf_raw "Variant" "↑↓ navigate  /  type to filter  /  Enter to select  /  Esc to quit")
  else
    local menu_file
    menu_file="/tmp/ollama-launch-variant-$$"
    printf '%s\n' "${lines[@]}" > "$menu_file"
    selected=$(pick_menu_raw "variant" "$menu_file")
    rm -f "$menu_file"
  fi

  if [ -z "$selected" ]; then exit 0; fi
  local raw_variant="${selected%% | *}"
  local _esc; _esc=$(printf '\033')
  raw_variant=$(printf '%s' "$raw_variant" | sed "s/${_esc}\[[0-9;]*m//g")
  echo "$raw_variant"
}

# ── flag parsing ──────────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h)
    echo "Usage: ollama-launch [--help] [--version] [--list-agents] [--list-models [--cloud]] [-p]"
    echo
    echo "  (no args)              Pick an agent and model interactively, then launch"
    echo "  -p, --print            Print the ollama command instead of executing it"
    echo "  --list-agents          Print all available agents and exit"
    echo "  --list-models          Print all available models and exit"
    echo "  --list-models --cloud  Print only models that have a :cloud variant and exit"
    echo "  --version              Print version and exit"
    echo "  --help                 Show this help and exit"
    echo
    echo "Example command run: ollama launch claude --model granite4.1:8b"
    exit 0
    ;;
  --version|-v)
    echo "ollama-launch $VERSION"
    exit 0
    ;;
  --list-agents)
    print_agents
    exit 0
    ;;
  --list-models)
    if [ "${2:-}" = "--cloud" ]; then
      print_models_cloud
    else
      print_models
    fi
    exit 0
    ;;
  -p|--print)
    OLLAMA_LAUNCH_PRINT=1
    ;;
  "")
    ;;
  *)
    echo -e "${BOLD_RED}Error:${RESET} Unknown option: ${1}"
    echo "Run 'ollama-launch --help' for usage."
    exit 1
    ;;
esac

# ── main ──────────────────────────────────────────────────────────────────────
if [ -n "${OLLAMA_LAUNCH_SKIP_MAIN:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

check_ollama
print_header

# ── fzf check ─────────────────────────────────────────────────────────────────
if ! command -v fzf &>/dev/null; then
  if [ -z "${OLLAMA_LAUNCH_TEST:-}" ]; then
    echo -e "${BOLD_RED}fzf is not installed.${RESET}"
    echo "  fzf provides a better selection experience with search/filter."
    echo
    printf "  Install fzf now? [y/N] "
    read -r install_fzf_choice 2>/dev/null || { echo; exit 0; }
    if [[ "$install_fzf_choice" =~ ^[Yy]$ ]]; then
      install_fzf
    else
      echo -e "  ${WHITE}Continuing with menu-based selection...${RESET}"
      echo
    fi
  fi
fi

# ── recent quick-launch ───────────────────────────────────────────────────────
load_history
RECENT_AGENT=""
RECENT_MODEL=""
if [ "${#HISTORY_ENTRIES[@]}" -gt 0 ]; then
  pick_recent
fi

if [ -n "$RECENT_AGENT" ] && [ -n "$RECENT_MODEL" ]; then
  # ── recent entry selected: skip all pickers ──────────────────────────────────
  agent="$RECENT_AGENT"
  final_model="$RECENT_MODEL"
  echo -e "  ${BOLD_CYAN}Recent:${RESET}  ${BOLD_GREEN}${agent}${RESET}  →  ${BOLD_GREEN}${final_model}${RESET}"
  echo
else
  # ── step 1: pick agent (skip if chosen from recent popup) ───────────────────
  if [ -n "$RECENT_AGENT" ]; then
    agent="$RECENT_AGENT"
  elif command -v fzf &>/dev/null; then
    agent=$(pick_fzf "Agent" "↑↓ navigate  /  type to filter  /  Enter to select  /  Esc to quit" print_agents)
    if [ -z "$agent" ]; then exit 0; fi
  else
    pick_menu "agent" AGENTS
    agent="$PICK_RESULT"
    if [ -z "$agent" ]; then exit 0; fi
  fi

  echo -e "  Agent:  ${BOLD_GREEN}${agent}${RESET}"
  echo

  # ── step 2: pick model ──────────────────────────────────────────────────────
  pick_model
  model_name="$PICK_RESULT"
  if [ -z "$model_name" ]; then exit 0; fi

  echo -e "  Model:  ${BOLD_GREEN}${model_name}${RESET}"
  echo

  # ── step 2b: pick variant (if applicable) ─────────────────────────────────
  final_model="$model_name"
  if [ "$PICK_MODEL_INDEX" -ge 0 ] && [ "${MODEL_HAS_VARIANTS[$PICK_MODEL_INDEX]}" -eq 1 ]; then
    variant=$(pick_variant "$PICK_MODEL_INDEX")
    if [ -n "$variant" ]; then
      final_model="$variant"
    fi
  fi

  if [ "$final_model" != "$model_name" ]; then
    echo -e "  Variant: ${BOLD_GREEN}${final_model}${RESET}"
    echo
  fi
fi

# ── launch ────────────────────────────────────────────────────────────────────
save_history "$agent" "$final_model"
if [ -n "${OLLAMA_LAUNCH_TEST:-}" ]; then
  echo "ollama launch ${agent} --model ${final_model}"
  exit 0
fi
if [ -n "${OLLAMA_LAUNCH_PRINT:-}" ]; then
  echo -e "\n${BOLD_CYAN}Command:${RESET} ${BOLD_AMBER}ollama launch ${agent} --model ${final_model}${RESET}\n"
  exit 0
fi

echo -e "${BOLD_CYAN}Running:${RESET} ollama launch ${agent} --model ${final_model}"
echo
exec ollama launch "$agent" --model "$final_model"
