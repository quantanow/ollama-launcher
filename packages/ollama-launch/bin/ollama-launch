#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
[ -L "$SCRIPT_SOURCE" ] && SCRIPT_SOURCE=$(readlink -f "$SCRIPT_SOURCE" 2>/dev/null || readlink "$SCRIPT_SOURCE")
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# package.json may be in SCRIPT_DIR (dev) or parent (installed via npm)
pkg_ver=""
for dir in "$SCRIPT_DIR" "$SCRIPT_DIR/.."; do
  if [ -f "$dir/package.json" ]; then
    ver=$(grep '"version"' "$dir/package.json" | sed 's/.*"version": "\([^"]*\)".*/\1/')
    if [ -n "$ver" ]; then
      pkg_ver="$ver"
      break
    fi
  fi
done
VERSION="${pkg_ver:-1.1.13}"

# ── colors (disabled when stdout is not a TTY) ────────────────────────────────
if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[36m'
  WHITE='\033[37m'
  GREEN='\033[32m'
  RED='\033[31m'
  AMBER='\033[38;5;214m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' WHITE='' GREEN='' RED='' AMBER='' RESET=''
fi

BOLD_CYAN="${BOLD}${CYAN}"
BOLD_WHITE="${BOLD}${WHITE}"
BOLD_GREEN="${BOLD}${GREEN}"
BOLD_AMBER="${BOLD}${AMBER}"

# fzf display colors — always defined (not TTY-gated) because fzf reads from a pipe
FZF_NAME=$'\033[1;96m'  # bold bright cyan — model/variant name
FZF_META=$'\033[2m'     # dim — pulls, tags, size details
FZF_RST=$'\033[0m'      # reset
BOLD_RED="${BOLD}${RED}"

# ── agent list ────────────────────────────────────────────────────────────────
AGENTS=(
  "claude"
  "codex"
  "hermes"
  "openclaw"
  "opencode"
)

